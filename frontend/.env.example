# Copy to .env.local and fill in. Never commit .env.local — this repo is public.

# Strapi CMS the site reads content from.
# Prod CMS (normal for local dev):
STRAPI_URL=https://cms-production-4424.up.railway.app
# Local Strapi instead (only if running `npm run dev:cms`):
# STRAPI_URL=http://localhost:1337

# Public base URL used for canonical links, sitemap and robots.
NEXT_PUBLIC_SITE_URL=http://localhost:4000

# Shared secret for POST /api/revalidate (flushes the ISR cache after a content
# change). Ask Edouard for the prod value; any string works locally.
REVALIDATION_SECRET=

# Optional. Not needed against prod Strapi — public read is open there.
# Only required if your local Strapi restricts read access.
# STRAPI_API_TOKEN=

# Optional. Enables the site-wide password gate in src/middleware.ts.
# Leave unset locally so the gate stays open; it is set in Vercel for prod.
# SITE_PASSWORD=
