# Copy to .env.local. The defaults below work as-is for local development — no
# secrets required. Never commit .env.local — this repo is public.

# Strapi CMS the site reads content from.
# Prod CMS (normal for local dev):
STRAPI_URL=https://cms-production-4424.up.railway.app
# Local Strapi instead (only if running `npm run dev:cms`):
# STRAPI_URL=http://localhost:1337

# Public base URL used for canonical links, sitemap and robots.
NEXT_PUBLIC_SITE_URL=http://localhost:4000

# Optional. Shared secret for POST /api/revalidate (flushes the ISR cache after a
# content change). Not needed for local development — the endpoint just stays
# closed. Any string works if you want to test it.
# REVALIDATION_SECRET=

# Optional. Not needed against prod Strapi — public read is open there.
# Only required if your local Strapi restricts read access.
# STRAPI_API_TOKEN=

# Optional. Enables the site-wide password gate in src/middleware.ts. The gate also
# lifts on its own at the embargo instant in src/lib/embargo.ts
# (2026-11-25T09:00:00-05:00). Leave unset locally so the gate stays open; it is set
# in Vercel for prod.
# SITE_PASSWORD=

# ── Mailchimp newsletter signup (footer) ────────────────────────────────
# Needed only for the footer newsletter form. Without these the form returns
# a "server_config" error and nothing is sent. Never commit the real key —
# this repo is public.

# Mailchimp → profile icon → Profile → Extras → API keys → Create A Key
# Format: 32 hex characters, a hyphen, then your datacentre prefix
# (the same prefix appears in your Mailchimp admin URL, e.g. us21).
MAILCHIMP_API_KEY=

# Mailchimp → Audience → Settings → Audience name and defaults → Audience ID
MAILCHIMP_AUDIENCE_ID=

# Comma-separated tags added to every website signup
MAILCHIMP_TAGS=Open Insights newsletter,Source: EPM website

# Change this whenever the consent wording changes (keep a copy of each version)
NEWSLETTER_CONSENT_VERSION=oi-consent-v1
